{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@doip/shared": ["./shared/src/index.ts"],
      "@/*": ["./web/src/*"]
    },
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "allowJs": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
